{
  "displayName": "Generate README",
  "description": "Generate a README.md file for this dataset using Borealis README.gen",
  "toolName": "borealis-readme-gen",
  "scope": "dataset",
  "types": [
    "configure"
  ],
  "toolUrl": "https://borealis-readme-gen.vercel.app",
  "httpMethod": "GET",
  "toolParameters": {
    "queryParameters": [
      {
        "datasetPid": "{datasetPid}"
      },
      {
        "siteUrl": "{siteUrl}"
      },
      {
        "locale": "{localeCode}"
      }
    ]
  },
  "allowedApiCalls": [
    {
      "name": "getDatasetMetadata",
      "httpMethod": "GET",
      "urlTemplate": "/api/v1/datasets/:persistentId/versions/:latest?persistentId={datasetPid}",
      "timeOut": 30
    },
    {
      "name": "getFiles",
      "httpMethod": "GET",
      "urlTemplate": "/api/v1/datasets/:persistentId/versions/:latest/files?persistentId={datasetPid}",
      "timeOut": 30
    },
    {
      "name": "addFile",
      "httpMethod": "POST",
      "urlTemplate": "/api/v1/datasets/:persistentId/add?persistentId={datasetPid}",
      "timeOut": 60
    }
  ]
}
