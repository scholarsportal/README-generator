/* Add these to your existing app/page.module.css */

.notLaunched {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: calc(100vh - 57px);
  padding: 3rem;
  text-align: center;
  gap: 0.75rem;
}

.notLaunchedGlyph {
  font-family: var(--serif);
  font-size: 3.5rem;
  font-weight: 300;
  font-style: italic;
  color: var(--border-mid);
  line-height: 1;
  margin-bottom: 0.5rem;
}

.notLaunchedTitle {
  font-family: var(--serif);
  font-size: 1.2rem;
  font-weight: 300;
  color: var(--muted);
}

.notLaunchedSub {
  font-size: 12px;
  color: var(--hint);
  max-width: 340px;
  line-height: 1.6;
}
