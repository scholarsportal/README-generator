/* Add these to your existing components/Sidebar/Sidebar.module.css */

.fetchingState {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 1rem;
  font-size: 12px;
  color: var(--hint);
}

.spinner {
  width: 14px;
  height: 14px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  flex-shrink: 0;
}

@keyframes spin { to { transform: rotate(360deg); } }
